# Tango Arranger - Node.js / Vue 3 / Vite / TypeScript

# Installed dependencies and package-manager caches
node_modules/
.pnpm-store/
.npm/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

# Production and preview build output
dist/
dist-ssr/
coverage/
.vite/
.vite-temp/

# TypeScript incremental build metadata
*.tsbuildinfo

# Logs and diagnostic output
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Local secrets / machine-specific configuration
.env
.env.*
!.env.example
!.env.*.example
*.local

# Editor and IDE state
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Operating-system artifacts
.DS_Store
Thumbs.db
Desktop.ini

# Generated test score (regression suite overwrites this file)
tests/generated-smoke.musicxml

# Temporary files
*.tmp
*.temp
*.bak
*~

# Intentionally tracked when needed:
# package-lock.json / pnpm-lock.yaml / yarn.lock
# *.musicxml / *.tango (musical source files and projects)
